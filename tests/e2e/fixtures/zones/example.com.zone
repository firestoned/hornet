;
; Forward zone with the common RR types.
$ORIGIN example.com.
$TTL 1h

@       IN  SOA ns1.example.com. hostmaster.example.com. (
                2024010101  ; serial
                1d          ; refresh
                2h          ; retry
                4w          ; expire
                5m )        ; minimum

@       IN  NS  ns1.example.com.
@       IN  NS  ns2.example.com.

@       IN  A   192.0.2.34
@       IN  AAAA 2001:db8::34

ns1     IN  A   192.0.2.35
ns2     IN  A   192.0.2.36

www     IN  CNAME @
mail    IN  A   192.0.2.37
@       IN  MX  10 mail.example.com.
@       IN  MX  20 mail2.example.net.

@       IN  TXT "v=spf1 a mx -all"
_sip._tcp   IN  SRV 10 60 5060 sip.example.com.
sip     IN  A   192.0.2.38
@       IN  CAA 0 issue "letsencrypt.org"
short   300 IN  A   192.0.2.39
